# Copy to .env.local for local development with sync. Both values are public by design:
# row-level security on the database is what keeps your data private.
# Supabase dashboard -> Project Settings -> API (or the Connect button).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
